# Environment for deploy/sound-catcher.service — see the README for every variable.
REDIS_ADDR=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAMS=messages
SOUND_SINKS=local,browser
SOUND_API_TOKEN=change-me
# A voice name in TTS_VOICES_DIR (or a path to an .onnx); the language of the
# profile's `say` templates should match it
TTS_VOICES_DIR=/home/homerun/homerun2-sound-catcher/voices
TTS_VOICE=en_US-lessac-medium
PROFILE_PATH=/home/homerun/homerun2-sound-catcher/profile.yaml
PREROLL=500ms
LOG_FORMAT=json
# Bluetooth speaker, for bt-reconnect.timer (bluetoothctl devices lists it)
SPEAKER_MAC=
# Sounds from S3 (docs/s3-sounds.md). Empty bucket: bundled clips only.
SOUNDS_S3_BUCKET=
SOUNDS_S3_ENDPOINT=
SOUNDS_S3_PREFIX=
# Read-only user; keep this file chmod 600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
